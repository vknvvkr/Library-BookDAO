package org.example;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class LibraryDAO {

    public void addAuthor(String name, String country) {

        String sql = "INSERT INTO authors (name, country) VALUES (?, ?)";

        try (
                Connection connection = DBConnection.getConnection();
                PreparedStatement statement = connection.prepareStatement(sql)
        ) {

            statement.setString(1, name);
            statement.setString(2, country);

            statement.executeUpdate();

            System.out.println("Автор добавлен!");

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }


    public void addReader(String name, String phone) {

        String sql = "INSERT INTO readers (name, phone) VALUES (?, ?)";

        try (
                Connection connection = DBConnection.getConnection();
                PreparedStatement statement = connection.prepareStatement(sql)
        ) {

            statement.setString(1, name);
            statement.setString(2, phone);

            statement.executeUpdate();

            System.out.println("Читатель добавлен!");

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }


    public List<String> getAllLoans() {

        List<String> loans = new ArrayList<>();

        String sql = """
                SELECT loans.id, books.title, readers.name, loans.loan_date
                FROM loans
                JOIN books ON loans.book_id = books.id
                JOIN readers ON loans.reader_id = readers.id
                """;

        try (
                Connection connection = DBConnection.getConnection();
                Statement statement = connection.createStatement();
                ResultSet result = statement.executeQuery(sql)
        ) {

            while (result.next()) {

                loans.add("ID: " + result.getInt("id") +
                        ", Книга: " + result.getString("title") +
                        ", Читатель: " + result.getString("name") +
                        ", Дата: " + result.getDate("loan_date"));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return loans;
    }


    public void addLoan(int bookId, int readerId, Date date) {

        String sql = """
                INSERT INTO loans (book_id, reader_id, loan_date)
                VALUES (?, ?, ?)
                """;

        try (
                Connection connection = DBConnection.getConnection();
                PreparedStatement statement = connection.prepareStatement(sql)
        ) {

            statement.setInt(1, bookId);
            statement.setInt(2, readerId);
            statement.setDate(3, date);

            statement.executeUpdate();

            System.out.println("Книга выдана!");

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }


    public void returnBook(int id, Date date) {

        String sql = """
                UPDATE loans
                SET return_date = ?, status = 'Возвращена'
                WHERE id = ?
                """;

        try (
                Connection connection = DBConnection.getConnection();
                PreparedStatement statement = connection.prepareStatement(sql)
        ) {

            statement.setDate(1, date);
            statement.setInt(2, id);

            statement.executeUpdate();

            System.out.println("Книга возвращена!");

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
